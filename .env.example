# --- Database ---
# Local dev: the Postgres+pgvector container from docker-compose.yml.
# (Running uvicorn on the host connects via localhost:5432.)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/content_suite

# Supabase alternative (Session pooler, port 5432 — NOT 6543, NOT the IPv6-only
# direct connection). Change the scheme to postgresql+asyncpg:// and drop any
# ?sslmode=require:
#   postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Auth / JWT ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Shared password for the seeded role users: creador / aprobador_a / aprobador_b / admin
SEED_PASSWORD=password123

# --- CORS (JSON array) ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- AI providers (used in later modules) ---
GOOGLE_API_KEY=
GROQ_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# --- RAG retrieval ---
# How many manual chunks to retrieve per ad generation (defaults to 8 if unset).
RAG_TOP_K=8

# --- Manual generation ---
# Soft range for how many sections the AI generates per manual (defaults 12 / 20).
MANUAL_MIN_SECTIONS=12
MANUAL_MAX_SECTIONS=20

# --- Supabase Storage (Module III image assets) ---
# Create a Supabase project, add a Storage bucket (public), and paste its ref URL
# + a service_role key. SUPABASE_URL like https://<ref>.supabase.co
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=ad-images
